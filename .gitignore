# Secretos y credenciales de Google (nunca al repositorio)
credenciales.json
# token*.json y no token.json a secas: si algun dia se autoriza una segunda
# cuenta de correo (token_personal.json), el patron amplio evita que ese token
# quede fuera del ignore y termine en el repositorio.
token*.json

# Configuración específica del negocio (contiene los IDs de los Sheets)
config.yaml

# Salidas de la corrida: log y cualquier archivo generado
salida/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/

# Editor / SO
.vscode/
.idea/
Thumbs.db
.DS_Store
